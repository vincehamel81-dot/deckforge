# Root .env — read by docker-compose.yml only.
# For native dev (go run / npm run dev), use backend/.env and frontend/.env instead.
#
# Usage:
#   cp .env.example .env
#   # Set JWT_SECRET, then:
#   docker compose up --build

JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h

DB_DRIVER=sqlite
# DATABASE_URL defaults to /data/deckforge.db (Docker volume) — leave unset for SQLite
# DATABASE_URL=postgres://deckforge:deckforge@db:5432/deckforge?sslmode=disable

CORS_ORIGIN=http://localhost:5173

MIN_PLAYERS=2
MAX_PLAYERS=8
MAX_USERNAME_LENGTH=15
ADMIN_SEED_USERNAMES=

AUTO_END_GAME=true
DISCONNECT_TIMEOUT_SECONDS=30

LOG_LEVEL=info
LOG_FORMAT=json

DEBUG_ENABLED=false
# DEBUG_TOKEN=
