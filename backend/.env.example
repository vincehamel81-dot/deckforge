PORT=8080
DB_DRIVER=sqlite
DATABASE_URL=deckforge.db
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h
CORS_ORIGIN=http://localhost:5173
MIN_PLAYERS=2
MAX_PLAYERS=8
MAX_USERNAME_LENGTH=15
ADMIN_SEED_USERNAME=
AUTO_END_GAME=true
DISCONNECT_TIMEOUT_SECONDS=30
# Logging
# LOG_LEVEL: debug | info | warn | error  (default: info)
#   Flip to debug in production to diagnose issues — change env var + restart, no deploy.
LOG_LEVEL=debug
# LOG_FORMAT: json | text  (default: json)
#   "text" gives coloured pretty-print for local dev; "json" for production log aggregators.
LOG_FORMAT=text

# Debug routes (/debug/error, /debug/warn). Off by default — safe to enable in
# production when needed: set DEBUG_ENABLED=true and DEBUG_TOKEN=<secret>.
# Requests without the matching X-Debug-Token header are rejected (401).
DEBUG_ENABLED=true
# DEBUG_TOKEN=
